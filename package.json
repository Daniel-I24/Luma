{
  "name": "luma",
  "version": "1.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "ng lint",
    "build:prod": "node scripts/generate-env.mjs && node scripts/build-legal.mjs && node scripts/build-flags.mjs ng build --configuration production,deploy",
    "build:legal": "node scripts/build-legal.mjs",
    "test:scripts": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test scripts/*.test.mjs",
    "ai:smoke": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/ai-smoke.mjs",
    "test:e2e": "node --test --test-concurrency=1 e2e/*.e2e.mjs",
    "apk:debug": "node scripts/apk.mjs debug",
    "apk:release": "node scripts/apk.mjs release",
    "check:interactive": "node scripts/check-interactive.mjs",
    "check:validation": "node scripts/check-validation.mjs",
    "check:responsive": "node scripts/check-responsive.mjs",
    "verify:backend": "node scripts/verify-backend.mjs",
    "apk:verify": "node scripts/apk-verify.mjs",
    "apk:demo": "node scripts/apk-demo.mjs",
    "check:hardcoded-urls": "node scripts/check-hardcoded-urls.mjs",
    "check:contrast": "node scripts/brand-contrast.mjs",
    "check:buttons": "node scripts/check-destructive-buttons.mjs",
    "check:tokens": "node scripts/check-design-tokens.mjs",
    "check:placeholders": "node scripts/check-placeholders.mjs",
    "scan:history": "node scripts/secret-scan-history.mjs",
    "check:google-services": "node scripts/check-google-services.mjs",
    "check:wompi-event": "node scripts/check-wompi-event.mjs",
    "wompi:replay": "node scripts/wompi-replay.mjs",
    "lint:functions": "node scripts/lint-functions.mjs",
    "doctor": "node scripts/doctor.mjs"
  },
  "private": true,
  "packageManager": "npm@11.21.0",
  "dependencies": {
    "@angular/common": "^22.2.4",
    "@angular/compiler": "^22.2.4",
    "@angular/core": "^22.2.4",
    "@angular/forms": "^22.2.4",
    "@angular/platform-browser": "^22.2.4",
    "@angular/router": "^22.2.4",
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/browser": "8.0.5",
    "@capacitor/core": "^8.5.3",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/keyboard": "^8.0.6",
    "@capacitor/network": "^8.0.1",
    "@capacitor/push-notifications": "8.1.3",
    "@capacitor/status-bar": "^8.0.4",
    "@jsverse/transloco": "^8.4.0",
    "@supabase/supabase-js": "^2.118.0",
    "@tailwindcss/postcss": "^4.3.3",
    "maplibre-gl": "^6.15.0",
    "postcss": "^8.5.31",
    "rxjs": "~7.8.0",
    "tailwindcss": "^4.3.3",
    "tslib": "^2.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@angular/build": "^22.2.5",
    "@angular/cli": "^22.2.5",
    "@angular/compiler-cli": "^22.2.4",
    "@capacitor/cli": "^8.6.0",
    "@eslint/js": "^10.0.1",
    "@jsverse/transloco-utils": "^8.4.0",
    "@vitest/coverage-v8": "5.0.5",
    "angular-eslint": "22.5.0",
    "axe-core": "4.14.0",
    "eslint": "^10.13.0",
    "jsdom": "^30.1.3",
    "playwright-core": "1.63.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "esbuild@0.28.2": true,
    "lmdb@3.5.6": true,
    "msgpackr-extract@3.0.4": true
  }
}
