{
  "name": "luma",
  "version": "1.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "ng lint",
    "build:prod": "node scripts/generate-env.mjs && ng build --configuration production,deploy",
    "test:scripts": "node --test scripts/*.test.mjs",
    "apk:debug": "node scripts/apk.mjs debug",
    "apk:release": "node scripts/apk.mjs release",
    "check:interactive": "node scripts/check-interactive.mjs",
    "verify:backend": "node scripts/verify-backend.mjs",
    "apk:verify": "node scripts/apk-verify.mjs",
    "apk:demo": "node scripts/apk-demo.mjs",
    "check:hardcoded-urls": "node scripts/check-hardcoded-urls.mjs",
    "check:contrast": "node scripts/brand-contrast.mjs",
    "check:buttons": "node scripts/check-destructive-buttons.mjs",
    "check:tokens": "node scripts/check-design-tokens.mjs"
  },
  "private": true,
  "packageManager": "npm@11.21.0",
  "dependencies": {
    "@angular/common": "^22.2.3",
    "@angular/compiler": "^22.2.3",
    "@angular/core": "^22.2.3",
    "@angular/forms": "^22.2.3",
    "@angular/platform-browser": "^22.2.3",
    "@angular/router": "^22.2.3",
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/browser": "8.0.5",
    "@capacitor/core": "^8.5.3",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/keyboard": "^8.0.6",
    "@capacitor/network": "^8.0.1",
    "@capacitor/push-notifications": "8.1.3",
    "@capacitor/status-bar": "^8.0.4",
    "@jsverse/transloco": "^8.4.0",
    "@supabase/supabase-js": "^2.117.3",
    "@tailwindcss/postcss": "^4.3.3",
    "maplibre-gl": "^6.14.0",
    "postcss": "^8.5.28",
    "rxjs": "~7.8.0",
    "tailwindcss": "^4.3.3",
    "tslib": "^2.3.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@angular/build": "^22.2.3",
    "@angular/cli": "^22.2.3",
    "@angular/compiler-cli": "^22.2.3",
    "@capacitor/cli": "^8.5.3",
    "@eslint/js": "^10.0.1",
    "@jsverse/transloco-utils": "^8.4.0",
    "angular-eslint": "22.5.0",
    "eslint": "^10.9.1",
    "jsdom": "^30.1.2",
    "playwright-core": "1.63.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.71.1",
    "vitest": "^5.0.0"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "esbuild@0.28.2": true,
    "lmdb@3.5.6": true,
    "msgpackr-extract@3.0.4": true
  }
}
