{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "src/**/*.spec.ts",
    "scripts/*.mjs",
    "supabase/functions/*/index.ts",
    "supabase/functions/**/*.test.ts",
    "transloco.config.ts"
  ],
  "project": ["src/**/*.ts", "scripts/**/*.mjs", "supabase/functions/**/*.ts"],
  "ignore": ["src/environments/**"],
  "ignoreDependencies": ["@fontsource-variable/inter", "prettier", "@std/assert", "@angular-eslint/builder"]
}
